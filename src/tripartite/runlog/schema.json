      "type": "object"
    },
    "Metrics": {
      "additionalProperties": true,
      "description": "``runs/<run_id>/metrics.json`` (D7): the summary across seeds.",
      "properties": {
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
