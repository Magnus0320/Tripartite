        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null only when role == \"warmup\"; every other call carries query_id and seed (D7; enforced by the model).",
          "title": "Seed"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "thinking_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thinking Text"
        },
        "timing_ms": {
          "$ref": "#/$defs/TimingMs"
        },
        "tokens": {
          "$ref": "#/$defs/TokenCounts"
        },
        "ts": {
          "format": "date-time",
