                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                ],
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commonsense"
        },
        "commonsense_pass": {
          "title": "Commonsense Pass",
          "type": "boolean"
        },
        "delivered": {
          "title": "Delivered",
          "type": "boolean"
        },
        "event_id": {
          "format": "uuid4",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "eval",
          "default": "eval",
          "title": "Event Type",
          "type": "string"
        },
        "final_pass": {
          "title": "Final Pass",
          "type": "boolean"
        },
        "hard": {
          "anyOf": [
            {
              "additionalProperties": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                ],
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hard"
        },
        "hard_pass": {
          "title": "Hard Pass",
          "type": "boolean"
        },
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9]{8}T[0-9]{6}Z-(batch|single)-[0-9a-f]{8}-[0-9a-f]{4}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
