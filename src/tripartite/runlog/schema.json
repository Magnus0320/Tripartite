        "schema_version",
        "event_id",
        "seq",
        "ts",
        "run_id",
        "query_id",
        "seed",
        "delivered",
        "commonsense",
        "hard",
        "commonsense_pass",
        "hard_pass",
        "final_pass"
      ],
      "title": "EvalEvent",
      "type": "object"
