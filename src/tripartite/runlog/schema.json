          "title": "Metrics",
          "type": "object"
        },
        "n_queries": {
          "minimum": 0,
          "title": "N Queries",
          "type": "integer"
        },
        "non_delivery": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Non Delivery",
          "type": "object"
        },
        "parse": {
          "$ref": "#/$defs/ParseSummary"
        },
        "post_check_mode": {
          "title": "Post Check Mode",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9]{8}T[0-9]{6}Z-(batch|single)-[0-9a-f]{8}-[0-9a-f]{4}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        },
        "subset": {
          "title": "Subset",
          "type": "boolean"
        },
        "tokens": {
          "$ref": "#/$defs/TokenStats"
        }
