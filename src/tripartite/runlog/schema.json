          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null only when role == \"warmup\"; every other call carries query_id and seed (D7; enforced by the model).",
          "title": "Query Id"
        },
        "request": {
          "$ref": "#/$defs/LlmRequest"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Round"
        },
        "run_id": {
          "pattern": "^[0-9]{8}T[0-9]{6}Z-(batch|single)-[0-9a-f]{8}-[0-9a-f]{4}$",
