        "run_id",
        "kind",
        "config_hash",
        "created_at",
        "finished_at",
        "subset",
        "n_queries",
        "seeds",
        "post_check_mode",
        "metrics",
        "non_delivery",
        "parse",
        "tokens",
        "latency_ms"
