          "propertyNames": {
            "enum": [
              "Delivery Rate",
              "Commonsense Constraint Micro Pass Rate",
              "Commonsense Constraint Macro Pass Rate",
              "Hard Constraint Micro Pass Rate",
              "Hard Constraint Macro Pass Rate",
              "Final Pass Rate"
