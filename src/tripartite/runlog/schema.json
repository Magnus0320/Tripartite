    "MetricSummary": {
      "additionalProperties": true,
      "properties": {
        "mean": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean",
          "type": "number"
        },
        "per_seed": {
          "patternProperties": {
            "^-?[0-9]+$": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          },
          "title": "Per Seed",
          "type": "object"
